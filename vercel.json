{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_DEPLOY_TIME": "2026-08-05T23:33:20.406Z"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://34.68.12.111:3000/api/:path*"
    }
  ]
}